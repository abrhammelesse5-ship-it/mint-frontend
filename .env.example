# Strapi base URL used by the Next.js server (server components, ISR).
STRAPI_URL=http://localhost:1337
# Strapi base URL used by the browser (media files, view/download counters, forms).
# Usually the same as STRAPI_URL; must be reachable from visitors' browsers in production.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Optional read-only API token (Settings > API Tokens > "Read-only"). Leave empty to use the Public role.
STRAPI_API_TOKEN=
# Public URL of this website (used for canonical URLs, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seconds between ISR revalidations of CMS content (default 60)
REVALIDATE_SECONDS=60
